{
  "name": "@example-org/root",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "author": "",
  "workspaces": [
    "web",
    "demo",
    "docs",
    "packages/*",
    "packages/iam-proxy/*"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run --workspaces --if-present build",
    "build:packages": "npm run --workspaces --if-present build:lib",
    "lint:check": "npm run --workspaces --if-present lint:check",
    "lint:fix": "npm run --workspaces --if-present lint:fix",
    "prepare": "husky",
    "publish": "changeset publish",
    "version": "changeset version",
    "sort": "sort-package-json '**/package.json' --ignore '**/node_modules'",
    "test": "exit 0",
    "test:ui": "exit 0"
  },
  "devDependencies": {
    "@changesets/cli": "~2.25.0",
    "@commitlint/cli": "~19.8.0",
    "@commitlint/config-conventional": "~19.8.0",
    "eslint": "~9.27.0",
    "globals": "~15.15.0",
    "husky": "~9.1.7",
    "lint-staged": "~15.4.3",
    "npm-run-all": "~4.1.5",
    "prettier": "~3.5.1",
    "sort-package-json": "~2.15.1",
    "tsup": "~8.5.0",
    "typescript": "5.8.3"
  },
  "overrides": {
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "@module-federation/runtime-tools": "0.17.0",
    "cross-spawn": "~7.0.6"
  }
}
